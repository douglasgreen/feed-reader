{
  "name": "douglasgreen/feed-reader",
  "description": "RSS feed reader",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.6",
    "symfony/http-foundation": "^7.4",
    "symfony/yaml": "^7.4",
    "twig/twig": "^3.22"
  },
  "require-dev": {
    "douglasgreen/php-linter": "dev-main",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "rector/rector": "^2.5",
    "shipmonk/dead-code-detector": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "DouglasGreen\\FeedReader\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "php-linter",
      "php-cs-fixer fix --dry-run --verbose",
      "phpstan analyse",
      "rector process --dry-run"
    ],
    "lint:fix": [
      "php-cs-fixer fix",
      "rector process"
    ],
    "qa": [
      "@lint"
    ]
  }
}
