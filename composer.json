{
  "name": "douglasgreen/feed-reader",
  "description": "RSS feed reader",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.6",
    "symfony/http-foundation": "^7.4",
    "symfony/yaml": "^7.4",
    "twig/twig": "^3.22"
  },
  "require-dev": {
    "carthage-software/mago": "^1.57",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "DouglasGreen\\FeedReader\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "mago lint",
      "mago analyze"
    ],
    "lint:fix": [
      "mago lint --fix",
      "mago format"
    ],
    "lint:upgrade": [
      "rector process"
    ],
    "qa": [
      "@lint"
    ]
  }
}
